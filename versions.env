# Upstream pins: the only source of truth for what gets built.
# Rewritten by scripts/check-upstreams.sh (update workflow); edit by hand to pin or roll back.

# Base kernel: must match the ROM (LineageOS 22.2 -> lineage-22.2). Branch switches are manual.
KERNEL_REPO=LineageOS/android_kernel_xiaomi_surya
KERNEL_BRANCH=lineage-22.2
KERNEL_COMMIT=21aca2e848f6697311ad801176e4c4aa4ddc52c7

# Root: ReSukiSU / BakaSU, release tag (the manager APK of the same tag must be installed)
KSU_REPO=Baka-SU/BakaSU
KSU_TAG=v4.2.0-rc3

# SUSFS core patch + inline hooks for non-GKI 4.14
NONGKI_REPO=JackA1ltman/NonGKI_Kernel_Build_2nd
NONGKI_BRANCH=mainline
NONGKI_COMMIT=2464d7a2837e6e863b14130de0873c18a0df2db6

# Flashable zip framework
AK3_REPO=osm0sis/AnyKernel3
AK3_BRANCH=master
AK3_COMMIT=41f04bdb4ee30a44e429c2c1131d5e8bb32b15f1

# Toolchain
CLANG_REPO=kdrag0n/proton-clang
CLANG_BRANCH=master
CLANG_COMMIT=9fb011b183fe7e69b04b873ef6533b4b077e3c5e
